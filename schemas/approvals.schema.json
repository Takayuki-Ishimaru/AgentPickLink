{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-pick-link/approvals.schema.json",
  "title": "AgentPickLink local approvals",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workspaceKey": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "approvedBindings": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "alias": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                },
                "bindingFingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "capabilityClass": {
                  "type": "string",
                  "enum": [
                    "knowledge-only",
                    "actions-possible"
                  ]
                }
              },
              "required": [
                "alias",
                "bindingFingerprint",
                "capabilityClass"
              ],
              "additionalProperties": false
            }
          },
          "approvedConfigDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "approvalVersion": {
            "type": "number",
            "const": 1
          }
        },
        "required": [
          "workspaceKey",
          "approvedBindings",
          "approvedConfigDigest",
          "approvedAt",
          "approvalVersion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "approvals"
  ],
  "additionalProperties": false
}
