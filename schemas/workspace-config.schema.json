{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-pick-link/workspace-config.schema.json",
  "title": "AgentPickLink workspace request",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "agents": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "bindingFingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "alias"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "agents"
  ],
  "additionalProperties": false
}
